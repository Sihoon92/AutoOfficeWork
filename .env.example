# PostgreSQL 설정
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apc_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# 사내 LLM API 설정 (OpenAI 호환)
LLM_BASE_URL=http://your-internal-api/v1
LLM_API_KEY=your_api_key
LLM_MODEL=gpt-4o-mini   # 사내 모델명으로 변경

# MES WAS 설정
WAS_URL=http://your-was-server:8080/api/query
WAS_F_FCT_ID=
WAS_F_SITE_ID=
WAS_F_APP_ID=
WAS_F_MENU_ID=
WAS_F_LINE_ID=
WAS_F_SHOP_ID=
WAS_F_BLD_ID=
WAS_F_BIZ_ID=
WAS_F_WORK_ID=
WAS_F_VERSION=
WAS_F_LINE_RPRS_GROUP_ID=
WAS_F_DATA_AUTH=
WAS_LANG_CD=KOR
WAS_CRUD=R
