# ============================================================
# ReFoRCE Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- OpenAI (standard) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Azure OpenAI (use with --azure flag) ---
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here

# --- Snowflake credentials (stored as JSON file, not env var) ---
# Create snowflake_credential.json in reforce/ directory:
# {
#   "account": "your_account",
#   "user": "your_user",
#   "password": "your_password",
#   "warehouse": "your_warehouse",
#   "database": "your_database",
#   "schema": "your_schema"
# }

# --- BigQuery credentials (stored as JSON file, not env var) ---
# Place bigquery_credential.json service account key in reforce/ directory
