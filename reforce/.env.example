# ============================================================
# ReFoRCE Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- 사내 LLM API (OpenAI-compatible) ---
# LLM_BASE_URL, LLM_API_KEY, LLM_MODEL 이 모두 설정되면 자동으로 사내 API를 사용합니다.
LLM_BASE_URL=http://gensi.samsungsdi.net/api/llm/openai/v1
LLM_API_KEY=//
LLM_MODEL=/models/llm/gpt-oss-120b

# --- OpenAI (표준, 사내 API 미사용 시) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Azure OpenAI (--azure 플래그 사용 시) ---
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here

# --- Snowflake credentials (JSON 파일로 관리) ---
# reforce/ 폴더에 snowflake_credential.json 파일 생성:
# {
#   "account": "your_account",
#   "user": "your_user",
#   "password": "your_password",
#   "warehouse": "your_warehouse",
#   "database": "your_database",
#   "schema": "your_schema"
# }

# --- BigQuery credentials (JSON 파일로 관리) ---
# reforce/ 폴더에 bigquery_credential.json 서비스 계정 키 파일 배치
